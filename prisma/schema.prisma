// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole  @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]
}

enum LocationType {
  PARTNER_POOL
  HOTEL_POOL
  TRAINING_CENTRE
  CLIENT_PRIVATE_POOL
  OTHER
}

model Program {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
}

model Location {
  id          String       @id @default(uuid())
  name        String
  type        LocationType @default(TRAINING_CENTRE)
  address     String?
  city        String?
  state       String?
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  bookings    Booking[]
}

enum BookingStatus {
  PENDING
  CONFIRMED
  RESCHEDULE_REQUESTED
  COMPLETED
  CANCELLED
  REJECTED
  REFUND_PENDING
  REFUNDED
}

model Booking {
  id            String               @id @default(uuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id])
  programId     String
  program       Program              @relation(fields: [programId], references: [id])
  locationId    String
  location      Location             @relation(fields: [locationId], references: [id])
  preferredDate DateTime
  preferredTime String
  status        BookingStatus        @default(PENDING)
  totalAmount   Int                  @default(0)
  currency      String               @default("NGN")
  notes         String?
  adminNotes    String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  participants  BookingParticipant[]

  @@index([userId])
  @@index([programId])
  @@index([locationId])
  @@index([status])
  @@index([preferredDate])
}

model BookingParticipant {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fullName  String
  age       Int?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
}
